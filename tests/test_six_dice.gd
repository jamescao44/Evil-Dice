extends SceneTree
const Run = preload("res://scripts/progression/run_rules.gd")
const Pool = preload("res://scripts/dice/dice_turn.gd")
const Relics = preload("res://scripts/relics/relic_catalog.gd")
const Tarot = preload("res://scripts/tarot/tarot_catalog.gd")
var checks := 0
var failures := 0

func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error(label)

func fresh():
	var m = Run.new(20261016)
	m.enemies = [m.make_enemy(0)]
	m.enemies[0].hp = 100000
	m.enemies[0].max_hp = 100000
	m.begin_round()
	return m

func select(m, indices: Array) -> void:
	for index in indices: check(m.dice_turn.select(index), "Select unused die %d" % index)

func _initialize() -> void:
	var m = fresh()
	check(not m.dice_turn.select(0), "Cannot form a skill from unrolled initial faces")
	check(m.roll_pool(true,[1,3,1,3,2,6]) == range(6), "First throw rolls six dice")
	check(m.pending.is_empty() and m.phase == "roll", "Throw waits for a player-selected trio")
	check(m.perfect_combo == 1 and m.reroll_progress == 0, "Perfect builds combo without crediting treasure before turn end")
	select(m,[0,2,5])
	check(not m.dice_turn.select(3), "Selection cannot exceed three dice")
	var skill = m.form_selected_skill()
	check(skill.dice == [1,1,6] and skill.spare == 6, "Any three physical dice form the existing skill")
	check(not m.dice_turn.select(1) and not m.dice_turn.can_roll(), "A pending skill disables the entire dice pool")
	check(m.roll_pool(false,[3,3,2]).is_empty() and m.dice_turn.rolls_left == 2, "Pending skill blocks rerolls without spending a throw")
	check(m.form_selected_skill().is_empty(), "A second skill cannot form while one is pending")
	check(m.cancel_formed_skill() and m.dice_turn.locked.is_empty(), "Cancel releases the pending group")
	select(m,[1,3,4]); m.form_selected_skill(); m.apply_player()
	check(m.phase == "roll" and m.status_count(m.Status.MIGHT) == 2, "Using a support skill unlocks the remaining dice")
	check(m.roll_pool(false,[1,1,6]) == [0,2,5], "Only unused dice reroll after casting")
	check(m.dice_turn.values == [1,3,1,3,2,6], "Spent faces survive reroll")
	check(m.perfect_combo == 0, "Miss resets Perfect combo")
	select(m,[0,2,5]); m.form_selected_skill(); m.apply_player(0)
	check(m.phase == "enemy" and m.status_count(m.Status.MIGHT) == 1, "Second cast ends the phase and spends one buff charge")
	check(not m.enemies[0].acted, "Enemies have not acted between the two skills")
	m.enemies[0].intent = {"type":"attack","amount":0,"target":-1}
	m.enemy_act(0); m.end_round(); m.begin_round()
	check(m.round_number == 2 and m.dice_turn.rolls_left == 3 and m.dice_turn.locked.is_empty(), "Enemy phase resets the six-dice turn once")
	m = fresh()
	for i in range(3): check(m.roll_pool(false,[1,2,3,4,5,6]).size() == 6, "Three accepted rolls")
	check(m.roll_pool().is_empty() and m.dice_turn.rolls_left == 0, "Fourth roll is rejected")
	select(m,[3,4,5])
	m.form_selected_skill()
	m.apply_player(0)
	check(m.phase == "roll" and m.dice_turn.rolls_left == 0, "Remaining trio stays selectable after all rolls are spent")
	select(m,[0,1,2])
	m.form_selected_skill()
	m.apply_player(0)
	check(m.phase == "enemy", "Both skills work without any rerolls left")
	m = fresh()
	m.roll_pool(false,[1,2,3,4,5,6])
	select(m,[0,1,2])
	m.form_selected_skill()
	check(m.save_pending_skill() and m.phase == "roll", "Saving spends only its trio")
	var rolls: int = m.dice_turn.rolls_left
	check(m.begin_saved_cast(), "Saved bonus can be cast between skills")
	m.apply_player(0)
	check(m.phase == "roll" and m.dice_turn.rolls_left == rolls and m.dice_turn.locked.size() == 3, "Saved bonus preserves roll and dice budgets")
	check(m.end_dice_turn() and m.phase == "enemy", "Player can end with unused dice")
	m = fresh()
	check(not m.end_dice_turn(), "Cannot skip an untouched turn accidentally")
	m.statuses[m.Status.FROZEN].apply(1)
	m._prepare_player_turn()
	m.break_ice(); m.break_ice(); m.break_ice()
	check(m.phase == "enemy", "Breaking ice skips the entire six-dice turn")
	m = fresh()
	for id in Relics.DISABLED: m.relics.items.append({"id":id})
	check(not m.forces_perfect() and not m.RelicEffects.has_flag(m.relics.items,"no_treasure"), "Disabled watch cannot force Perfect or block treasure")
	for id in Tarot.DISABLED:
		var card: Dictionary = m.grant_tarot(id)
		var result: Dictionary = m.tarot_effects.cast(m,card.instance_id)
		check(result.has("error") and m.tarots.items.any(func(item): return item.instance_id == card.instance_id), "Disabled tarot is inspectable and never consumed: " + id)
	for i in range(500):
		check(Tarot.draw_one(m.reward_rng) not in Tarot.DISABLED, "Random tarot excludes suspended effects")
		check(m.relics.draw_one(m.reward_rng) not in Relics.DISABLED, "Random relic excludes suspended effects")
	m = fresh()
	m.relics.add("worn_bow")
	m.relics.add("tissue_pack")
	m.relics.add("magic_slingshot")
	m.roll_pool(false,[1,2,3,4,4,6])
	check(m.roll_relic_actions.size() == 1 and m.roll_relic_actions[0].id == "worn_bow", "Per-throw relics fire without assuming a three-die result")
	while m.perfect_relic_ready: m.resolve_roll_relic_step()
	select(m,[0,1,2])
	m.form_selected_skill()
	check(m.roll_relic_actions.is_empty(), "Cancellable formations cannot fire free relic attacks")
	check(m.cancel_formed_skill(), "Cancel normal skill before committing bonuses")
	select(m,[0,1,2]); m.form_selected_skill()
	check(m.save_pending_skill(), "Saving commits the trio")
	check(m.roll_relic_actions.size() == 1 and m.roll_relic_actions[0].id == "tissue_pack", "All-different proc fires once when the trio is saved")
	while m.perfect_relic_ready: m.resolve_roll_relic_step()
	select(m,[3,4,5])
	m.form_selected_skill()
	check(m.begin_player_cast(), "Casting commits the pair")
	check(m.roll_relic_actions.size() == 1 and m.roll_relic_actions[0].id == "magic_slingshot" and m.roll_relic_actions[0].amount == 6, "Pair proc uses the selected spare die at cast start")
	check(not m.cancel_formed_skill(), "Cannot unlock a skill after casting begins")
	m = fresh()
	var cards: Array = Tarot.eligible()
	m.tarot_effects.banned = cards.slice(0,cards.size()-1)
	check(not m.tarot_effects.error(m,"hanged_man").is_empty(), "Ban cannot empty the reduced active tarot deck")
	check(Tarot.draw_one(m.reward_rng,m.tarot_effects.banned) == cards[-1], "Remaining active card stays obtainable")
	m = fresh()
	m.roll_pool(false,[1,2,3,4,5,6])
	select(m,[0,1,2]); m.form_selected_skill()
	check(m.save_pending_skill() and m.phase == "roll", "Saving unlocks the unused dice")
	select(m,[3,4,5]); m.form_selected_skill()
	check(not m.save_pending_skill(), "Full saved slot cannot consume the second trio")
	check(m.begin_saved_cast(), "Saved bonus can interrupt a ready second trio")
	m.apply_player(0)
	check(m.pending.dice == [4,5,6] and m.phase == "player", "Saved bonus restores the waiting trio")
	check(not m.dice_turn.can_roll(), "Saved bonus does not unlock the current pending trio")
	m.apply_player(0)
	check(m.phase == "enemy", "Saved first trio plus second cast ends exactly one turn")
	m = fresh()
	m.roll_pool(false,[1,2,3,4,5,6])
	select(m,[0,1,2]); m.form_selected_skill()
	check(m.cancel_formed_skill() and m.phase == "roll", "Cancellation restores selection")
	check(m.dice_turn.rolls_left == 2 and m.dice_turn.values == [1,2,3,4,5,6], "Cancellation preserves faces and remaining throws")
	check(m.roll_pool(false,[6,6,6,4,5,6]) == range(6), "All unspent dice can reroll after cancellation")
	m.roll_pool(false,[1,2,3,4,5,6])
	select(m,[0,1,2]); m.form_selected_skill()
	check(m.cancel_formed_skill() and m.dice_turn.rolls_left == 0, "Zero-roll cancellation still unlocks dice")
	select(m,[2,1,0]); m.form_selected_skill(); m.apply_player(0)
	check(not m.dice_turn.release_group([2,1,0]) and m.dice_turn.locked.size() == 3, "Already-used dice cannot be refunded")
	select(m,[3,4,5]); m.form_selected_skill()
	check(m.cancel_formed_skill() and m.dice_turn.locked == [2,1,0], "Cancelling the second group preserves the spent first group")
	select(m,[3,4,5]); m.form_selected_skill(); m.apply_player(0)
	check(m.phase == "enemy", "Reconnecting and using the last trio ends the turn")
	var a = fresh()
	var b = fresh()
	check(a.roll_pool(true) == b.roll_pool(false) and a.dice_turn.values == b.dice_turn.values, "Perfect does not change natural dice distribution")
	var pool = Pool.new()
	var rng = RandomNumberGenerator.new()
	rng.seed = 41
	var frequencies := [0,0,0,0,0,0]
	for i in range(6000):
		pool.reset(); pool.roll(rng,true)
		for face in pool.values: frequencies[face-1] += 1
	for count in frequencies: check(abs(count-6000) < 300, "Each face remains uniform across six independent dice")
	m.load_debug_wave(19)
	for enemy in m.enemies: enemy.hp = 0
	check(m.outcome() == "victory" and not m.advance_wave(), "Run finishes at wave 19 and skips City Fever")
	print("Six-dice checks: %d passed, %d failed" % [checks-failures,failures])
	quit(1 if failures else 0)

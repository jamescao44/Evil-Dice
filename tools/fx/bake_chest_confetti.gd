extends SceneTree
## Sample the original paper simulation into cropped, packed transparent flipbooks.
## Run with Godot --path . --script tools/fx/bake_chest_confetti.gd (needs a renderer).
const Source = preload("res://tools/fx/confetti_source.gd")
const OUTPUT := "res://assets/art/fx/chest_confetti"
const FPS := 60.0
const DURATION := 4.4
const RESOLUTION := 1.0/3.0
const PAGE_SIZE := 2048
const SPECS := [
	["cannon",180,-0.95,0.6,1049], ["cannon",180,-0.95,0.6,2081],
	["bloom",120,-PI/2,PI,3037], ["bloom",120,-PI/2,PI,4093], ["bloom",120,-PI/2,PI,5059],
	["light_cannon",24,-0.95,0.6,6089], ["light_bloom",18,-PI/2,PI,7039],
]
var source = Source.new()
var pages: Array[Image] = []
var pen := Vector2i(2,2)
var row_height := 0
var clips: Dictionary = {}

func _initialize() -> void: call_deferred("bake")

## Find each frame's complete bounds, preserving tumbling ribbons and the final fade.
func frame_bounds() -> Rect2:
	var bounds := Rect2()
	var first := true
	for p in source.particles:
		var t: float = source.clock-p.born
		if t >= p.life: continue
		var drift: float = (1-exp(-t*0.85))/0.85
		var at: Vector2 = p.at+p.v*drift+Vector2(sin(t*3+p.phase)*t*14,0)
		var extent: Vector2 = p.size*Vector2(maxf(0.16,absf(cos(t*p.flutter+p.phase))),1)
		for corner in [Vector2(-1,-1),Vector2(1,-1),Vector2(1,1),Vector2(-1,1)]:
			var point: Vector2 = (at+(corner*extent*0.5).rotated(p.angle+t*p.spin))*RESOLUTION
			if first: bounds = Rect2(point,Vector2.ZERO); first = false
			else: bounds = bounds.expand(point)
	var start := bounds.position.floor()-Vector2.ONE*2
	return Rect2(start,bounds.end.ceil()+Vector2.ONE*2-start)

## Pack frames with transparent gutters; runtime draws only each frame's tight region.
func pack(image: Image) -> Array:
	var size := image.get_size()
	assert(size.x+4 <= PAGE_SIZE and size.y+4 <= PAGE_SIZE)
	if pen.x+size.x+2 > PAGE_SIZE: pen.x = 2; pen.y += row_height+2; row_height = 0
	if pages.is_empty() or pen.y+size.y+2 > PAGE_SIZE:
		pages.append(Image.create(PAGE_SIZE,PAGE_SIZE,false,Image.FORMAT_RGBA8))
		pen = Vector2i(2,2); row_height = 0
	var rect := Rect2i(pen,size)
	pages.back().blit_rect(image,Rect2i(Vector2i.ZERO,size),pen)
	pen.x += size.x+2
	row_height = maxi(row_height,size.y)
	return [pages.size()-1,Rect2(rect)]

## Bake fixed seeds offline, so no particle simulation or image capture runs in the game.
func bake() -> void:
	if DisplayServer.get_name() == "headless": push_error("Confetti baking needs a graphics renderer"); quit(1); return
	DirAccess.make_dir_recursive_absolute(OUTPUT)
	var viewport := SubViewport.new()
	viewport.transparent_bg = true
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	viewport.render_target_clear_mode = SubViewport.CLEAR_MODE_ALWAYS
	root.add_child(viewport)
	var canvas := Node2D.new()
	viewport.add_child(canvas)
	canvas.draw.connect(func(): source.paint(canvas))
	for spec in SPECS:
		source.clear(); source.rng.seed = spec[4]
		source.burst(Vector2.ZERO,Vector2(1280,800),spec[1],spec[2],spec[3])
		# Shared gravity is applied once to the baked sprite at runtime, at display FPS.
		for p in source.particles: p.gravity = 0.0
		var frames: Array = []
		for frame in range(ceili(DURATION*FPS)):
			source.advance(1.0/FPS if frame > 0 else 0.0)
			var bounds := frame_bounds()
			viewport.size = Vector2i(bounds.size)
			canvas.scale = Vector2.ONE*RESOLUTION
			canvas.position = -bounds.position
			canvas.queue_redraw()
			await process_frame
			RenderingServer.force_draw()
			var image: Image = viewport.get_texture().get_image()
			var packed := pack(image)
			frames.append([packed[0],packed[1],bounds.position/RESOLUTION])
		if not clips.has(spec[0]): clips[spec[0]] = []
		clips[spec[0]].append(frames)
		print("Baked %s seed %d (%d pages so far)" % [spec[0],spec[4],pages.size()])
	var script := "extends RefCounted\n## Generated by tools/fx/bake_chest_confetti.gd; edit the source and rebake.\nconst FPS := %s\nconst DURATION := %s\nconst RESOLUTION := %s\nconst PAGES := [\n" % [FPS,DURATION,RESOLUTION]
	for i in range(pages.size()):
		var path := OUTPUT+"/confetti_%02d.png" % i
		assert(pages[i].save_png(path) == OK)
		var config := ConfigFile.new()
		config.load(path+".import")
		config.set_value("remap","importer","texture")
		config.set_value("remap","type","CompressedTexture2D")
		config.set_value("params","compress/mode",4)
		config.set_value("params","compress/lossy_quality",0.95)
		config.set_value("params","mipmaps/generate",false)
		config.set_value("params","process/fix_alpha_border",true)
		config.save(path+".import")
		script += "\tpreload(\"%s\"),\n" % path
	script += "]\nconst CLIPS := "+var_to_str(clips)+"\n"
	FileAccess.open(OUTPUT+"/library.gd",FileAccess.WRITE).store_string(script)
	print("Confetti bake: %d pages, %.1f MiB RGBA, %d frames per variant" % [pages.size(),pages.size()*PAGE_SIZE*PAGE_SIZE*4.0/1048576.0,ceili(DURATION*FPS)])
	viewport.queue_free()
	await process_frame
	quit()

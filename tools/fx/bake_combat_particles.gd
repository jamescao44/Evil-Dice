extends SceneTree
## Render the offline recipes at 60 Hz into tightly cropped, compressed sprite atlases.
const Source = preload("res://tools/fx/combat_particle_source.gd")
const BakeImage = preload("res://tools/fx/bake_image.gd")
const OUTPUT := "res://assets/art/fx/combat_particles"
const PAGE_SIZE := 2048
var pages: Array[Image] = []
var pen := Vector2i(2,2)
var row_height := 0
var clips: Dictionary = {}
var source = Source.new()
var age := 0.0

func _initialize() -> void: call_deferred("bake")

## Leave transparent gutters around every cropped frame to prevent atlas bleeding.
func pack(image: Image) -> Array:
	var size := image.get_size()
	assert(size.x+4 <= PAGE_SIZE and size.y+4 <= PAGE_SIZE)
	if pen.x+size.x+2 > PAGE_SIZE: pen.x = 2; pen.y += row_height+2; row_height = 0
	if pages.is_empty() or pen.y+size.y+2 > PAGE_SIZE:
		pages.append(Image.create(PAGE_SIZE,PAGE_SIZE,false,Image.FORMAT_RGBA8))
		pen = Vector2i(2,2); row_height = 0
	var rect := Rect2i(pen,size)
	pages.back().blit_rect(image,Rect2i(Vector2i.ZERO,size),pen)
	pen.x += size.x+2
	row_height = maxi(row_height,size.y)
	return [pages.size()-1,Rect2(rect)]

## Capture all variants without importing a game scene or accessing player saves.
func bake() -> void:
	if DisplayServer.get_name() == "headless": push_error("Baking requires a renderer"); quit(1); return
	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
	Engine.max_fps = 0
	DirAccess.make_dir_recursive_absolute(OUTPUT)
	var viewport := SubViewport.new()
	viewport.transparent_bg = true
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	viewport.render_target_clear_mode = SubViewport.CLEAR_MODE_ALWAYS
	root.add_child(viewport)
	var canvas := Node2D.new()
	viewport.add_child(canvas)
	canvas.draw.connect(func(): source.paint(canvas,age))
	for spec in Source.recipes():
		source.prepare(spec)
		viewport.size = Vector2i((spec.bounds.size*spec.resolution).ceil())
		canvas.scale = Vector2.ONE*spec.resolution
		canvas.position = -spec.bounds.position*spec.resolution
		var frames: Array = []
		for frame in range(roundi(spec.duration*Source.FPS)):
			age = frame/Source.FPS
			canvas.queue_redraw()
			await process_frame
			RenderingServer.force_draw()
			var image: Image = viewport.get_texture().get_image()
			var used := image.get_used_rect()
			if used.size == Vector2i.ZERO: used = Rect2i(0,0,1,1)
			# Cropping never cuts visible pixels; 2px atlas gutters handle filtering.
			var packed := pack(BakeImage.straight_alpha(image.get_region(used)))
			frames.append([packed[0],packed[1],spec.bounds.position+Vector2(used.position)/spec.resolution])
		clips[spec.name] = {"duration":spec.duration,"loop":spec.loop,"resolution":spec.resolution,"frames":frames}
		print("Baked %s: %d frames" % [spec.name,frames.size()])
	var script := "extends RefCounted\n## Generated by tools/fx/bake_combat_particles.gd. Edit the recipes and rebake.\nconst FPS := 60.0\nconst PAGES := [\n"
	for i in range(pages.size()):
		var path := OUTPUT+"/particles_%02d.png" % i
		assert(pages[i].save_png(path) == OK)
		var config := ConfigFile.new()
		config.load(path+".import")
		config.set_value("remap","importer","texture")
		config.set_value("remap","type","CompressedTexture2D")
		config.set_value("params","compress/mode",0) # Lossless: preserve the baked orange/gold palette.
		config.set_value("params","compress/lossy_quality",0.95)
		config.set_value("params","mipmaps/generate",false)
		config.set_value("params","process/fix_alpha_border",true)
		config.set_value("params","process/premult_alpha",false)
		config.save(path+".import")
		script += "\tpreload(\"%s\"),\n" % path
	script += "]\nconst CLIPS := "+var_to_str(clips)+"\n"
	FileAccess.open(OUTPUT+"/library.gd",FileAccess.WRITE).store_string(script)
	print("Combat particles: %d pages, %.1f MiB uncompressed" % [pages.size(),pages.size()*16.0])
	viewport.queue_free()
	await process_frame
	quit()
